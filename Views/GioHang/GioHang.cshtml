@using CuaHangOto.Models
@model List<GioHang>

@{
    ViewBag.Title = "GioHang";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="text-align:center">THÔNG TIN GIỎ HÀNG</h2>
<table>
    <tr style="text-align:center; font-weight:bold">
        <td>Mã xe</td>
        <td>Tên xe</td>
        <td>Hình ảnh</td>
        <td>Số lượng</td>
        <td>Thành tiền</td>
        <td width="50px"></td>
        <td width="50px"></td>
        <td width="50px"></td>
    </tr>
    @foreach (var item in Model)
    {
        <tr style="text-align:center; font-weight:bold">
            <td> @item.iXe </td>
            <td> @item.xTen</td>
            <td><img alt="@item.xTen" src="/HinhAnh/@item.xHinhAnh" style="width: 50px; height: auto;"></td>
            @using (Html.BeginForm())
            {
                <td>
                    <input type="number" min="1" name="txtSoluong" value="@item.iSoLuong" style="background-color: #82B440; color:white" />
                </td>
                <td> @string.Format("{0:0,0}", item.dThanhTien)</td>
                <td> <a href="@Url.Action("DetailSP","Xe", new { id = item.iXe})"> Chi tiết </a></td>
                <td> @Html.ActionLink("Xóa", "XoaGioHang", new { @iXe = item.iXe })</td>
                
            }
        </tr>
    }
    <tr style="font-weight:bold; text-align:right; color:red">
        <td colspan="4"> Số lượng sách: @ViewBag.Tongsoluong </td>
        <td colspan="5"> Tổng tiền: @string.Format("{0:0,0}", ViewBag.Tongtien) Triệu - VNĐ </td>
    </tr>
    <tr style="font-weight: bold; color: blue; text-align:right ">
        <td colspan="9">
            @Html.ActionLink("Xóa Giỏ Hàng", "XoaTatGioHang")
        </td>
    </tr>
    @*<tr style="font-weight: bold; color: blue; text-align:right ">
        <td colspan="9" align="center">
            @Html.ActionLink("Đặt Hàng", "Dathang", "GioHang")
        </td>
    </tr>*@
</table>

