@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model CuaHangOto.Models.Xe

<h2>XÓA DÒNG XE</h2>

<fieldset>
    <legend>Fields</legend>
    <div class="display-label">Id xe: @Html.Encode(Model.XeId)</div>
    <div class="display-label">Tên xe: @Html.Encode(Model.Ten)</div>
    <div class="display-label">Mô tả: @Html.Encode(Model.Mota)</div>
</fieldset>
@using (Html.BeginForm())
{
    <p>
        <input type="submit" value="Xóa" style="color:red;" /> |
        @Html.ActionLink("Trở lại", "Xe")
    </p>
}



