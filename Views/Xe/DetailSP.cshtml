@model IEnumerable<CuaHangOto.Models.Xe>

@{
    ViewBag.Title = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/detail.css">

<div class="container">
    <div style="text-align:center">
        <h2>Trang Chi Tiết Thông Tin Xe</h2>
    </div>
    <div class="row">
        @*         <div class="column">
                <img src="/images/@Model.Ten" height="80%" width="80%" />
            </div> *@
        <div class="column">
            @foreach (var x in Model)
            {
                <img src="~/HinhAnh/@x.HinhAnh" alt="" loading="lazy" width="440" height="300" class="w-100">
                <form action="/action_page.php">
                    <h3 for="fname">Tên: @x.Ten</h3>

                    @* <input type="text" id="fname" name="firstname" placeholder="Your name.."> *@
                    <h3 for="fname">Tên: @x.Gia</h3>
                    <h3 for="fname">Tên: @x.NamSX</h3>
                    <h3 for="fname">Tên: @x.SoKM</h3>
                    <h3 for="fname">Tên: @x.Mau</h3>
                    <h3 for="fname">Tên: @x.NhienLieu</h3>
                    <h3 for="lname">Mô tả: @x.Mota</h3>


                    <a class="btn" href="@Url.Action("SanPham", "Xe")">Trở lại</a>
                </form>
            }
        </div>
    </div>
</div>

