        <!--
          - #FEATURED CAR
        -->

        <h2 class="h2 section-title">C</h2>

        <section class="section featured-car" id="featured-car">
            <div class="container">


                <div class="title-wrapper">
                    <h2 class="h2 section-title">Các xe đang có ở cửa hàng</h2>

                    <a href="product.html" class="featured-car-link">
                        <a class="btn" style="color: black; background-color: white;" href="@Url.Action("XeDongXe", "Xe")">Theo dòng xe</a>
                        <a class="btn" style="color: black; background-color: white;" href="@Url.Action("XeHangXe", "Xe")">Theo hãng xe</a>
                    </a>
                </div>




                <ul class="featured-car-list">
                    @foreach (var x in Model)
                    {
                        <li>
                            <div class="featured-car-card">

                                <figure class="card-banner">
                                    <img src="~/HinhAnh/@x.HinhAnh" alt="" loading="lazy" width="440" height="300"
                                         class="w-100">
                                </figure>

                                <div class="card-content">

                                    <div class="card-title-wrapper">
                                        <h3 class="h3 card-title">
                                            <a href="#">@x.Ten</a>
                                        </h3>

                                        <data class="year">@x.NamSX.Value.Year</data>
                                    </div>

                                    <ul class="card-list">

                                        <li class="card-list-item">
                                            <ion-icon name="people-outline"></ion-icon>

                                            <span class="card-item-text">Dòng @x.DongXe.Ten</span>
                                        </li>

                                        <li class="card-list-item">
                                            <ion-icon name="flash-outline"></ion-icon>

                                            <span class="card-item-text">Hãng @x.HangXe.Ten</span>
                                        </li>

                                        <li class="card-list-item">
                                            <ion-icon name="speedometer-outline"></ion-icon>

                                            <span class="card-item-text">Di chuyển @x.SoKM km</span>
                                        </li>

                                        <li class="card-list-item">
                                            <ion-icon name="hardware-chip-outline"></ion-icon>

                                            <span class="card-item-text">Nhiên liệu @x.NhienLieu</span>
                                        </li>

                                    </ul>

                                    <div class="card-price-wrapper">

                                        <p class="card-price">
                                            <strong>@x.Gia Triệu</strong>
                                        </p>

                                        <button class="btn fav-btn" aria-label="Add to favourite list">
                                            @*<ion-icon name="heart-outline"></ion-icon>*@
                                            Liên hệ
                                        </button>

                                        <a class="btn" href="@Url.Action("ThemGioHang", "GioHang", new {@iXe = x.XeId, @strURL = Request.Url.ToString()})">Thêm vào yêu thích</a>
                                        <a class="btn" href="@Url.Action("DetailSP", "Xe", new {id = x.XeId})">Chi tiết</a>
                                    </div>

                                </div>

                            </div>
                        </li>
                    }

                </ul>
            </div>
        </section>

       




