@model IEnumerable<CuaHangOto.Models.Xe>

@{
    ViewBag.Title = "XeTheoDongXe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<link rel="stylesheet" href="~/Content/css/style.css">
<link rel="stylesheet" href="~/Content/css/global.css">

<header class="header" data-header>
    <div class="container">

        <div class="overlay" data-overlay></div>

        <a href="@Url.Action("Index", "Home")" class="logo">
            <img src="~/HinhAnh/images/logo.svg" alt="Ridex logo">
        </a>

        <nav class="navbar" data-navbar>
            <ul class="navbar-list">
                @if (User.Identity.IsAuthenticated)
                {
                    if (User.IsInRole("Admin"))
                    {

                        <li>
                            <a href="@Url.Action("Index", "Admin")" class="navbar-link" data-nav-link>Dashboard</a>
                        </li>
                    }

                  

                        
                        <li>
                            <a href="@Url.Action("SanPham", "Xe")" class="navbar-link" data-nav-link>Sản phẩm</a>
                        </li>

                        <li>
                            <a href="@Url.Action("GioHang", "GioHang")" class="navbar-link" data-nav-link>Giỏ hàng</a>
                        </li>
                    


                }

                @if (!User.Identity.IsAuthenticated)
                {
                    <li>
                        <a href="#featured-car" class="navbar-link" data-nav-link>Khám phá</a>
                    </li>



                    <li><a href="product.html" class="navbar-link">Liên hệ</a></li>
                }
            </ul>
        </nav>

        <div class="header-actions">

            @*<div class="header-contact">
                    <a href="tel:0937149365" class="contact-link">(+84) 0937149365</a>

                    <span class="contact-time">168, Nguyễn Văn Cừ (nối dài), TP Cần Thơ</span>
                </div>*@

            @if (User.Identity.IsAuthenticated)
            {

             

                <li><a>Hello - @User.Identity.Name</a></li>
                <a href="@Url.Action("Logout", "Accounts")" class="btn user-btn" aria-label="Profile">
                    @*<ion-icon name="person-outline"></ion-icon>*@
                    Dang xuat
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "Accounts")" class="btn user-btn" aria-label="Profile">
                    @*<ion-icon name="person-outline"></ion-icon>*@
                    Dang nhap
                </a>
            }

        </div>

    </div>
</header>

